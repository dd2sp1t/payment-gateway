            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(\"http.route\", \"http.request.method\")(rate({__name__=\"http.server.request.duration_seconds_count\", \"http.route\" !~ \"/metrics|/health|/swagger.*\"}[$__rate_interval]))",
