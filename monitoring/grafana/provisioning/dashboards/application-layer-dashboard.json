    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 101,
            "title": "Application Layer Overview",
            "type": "row",
            "collapsed": false,
            "panels": []
        },
        {
            "datasource": "Prometheus",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineInterpolation": "smooth",
                        "lineWidth": 2
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 1
            },
            "id": 6,
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "showLegend": true,
                    "calcs": [
                        "lastNotNull",
                        "mean"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.50, sum(rate(application_request_duration_milliseconds_bucket[$__rate_interval])) by (le, application_request))",
                    "legendFormat": "{{application_request}} (p50)",
                    "refId": "A"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.95, sum(rate(application_request_duration_milliseconds_bucket[$__rate_interval])) by (le, application_request))",
                    "legendFormat": "{{application_request}} (p95)",
                    "refId": "B"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(application_request_duration_milliseconds_sum[$__rate_interval])) by (application_request) / sum(rate(application_request_duration_milliseconds_count[$__rate_interval])) by (application_request)",
                    "legendFormat": "{{application_request}} (avg)",
                    "refId": "C"
                }
            ],
            "title": "Request Latency",
            "type": "timeseries"
        },
        {
            "datasource": "Prometheus",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 15,
                        "lineInterpolation": "linear",
                        "lineWidth": 2
                    },
                    "unit": "ops"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Started"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "blue",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Succeeded"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "green",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Failed"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Concurrency Retry"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "orange",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 9
            },
            "id": 7,
            "options": {
                "legend": {
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "right",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(application_request_started_total[$__rate_interval]))",
                    "legendFormat": "Started",
                    "refId": "A"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(application_request_succeeded_total[$__rate_interval]))",
                    "legendFormat": "Succeeded",
                    "refId": "B"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(application_request_failed_total[$__rate_interval]))",
                    "legendFormat": "Failed",
                    "refId": "C"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(application_request_concurrency_retry_total[$__rate_interval]))",
                    "legendFormat": "Concurrency Retry",
                    "refId": "D"
                }
            ],
            "title": "Requests Timeline & Errors",
            "type": "timeseries"
        },
        {
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 17
            },
            "id": 8,
            "options": {
                "calculate": {
                    "x": {
                        "bins": {
                            "size": 10
                        },
                        "mode": "size"
                    },
                    "y": {
                        "bins": {
                            "size": 10
                        },
                        "mode": "size"
                    }
                },
                "color": {
                    "exponent": 0.5,
                    "fill": "#b3c4ff",
                    "mode": "scheme",
                    "reverse": false,
                    "scale": "exponential",
                    "scheme": "Spectral"
                },
                "exemplars": {
                    "color": "rgba(255,0,255,0.7)"
                },
                "rowsFrame": {
                    "layout": "labeled",
                    "title": ""
                },
                "tooltip": {
                    "show": true,
                    "yHistogram": true
                },
                "yAxis": {
                    "format": "ms",
                    "logBase": 1,
                    "max": null,
                    "min": "0"
                }
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(application_request_duration_milliseconds_bucket[$__rate_interval])) by (le)",
                    "format": "heatmap",
                    "legendFormat": "{{le}}",
                    "refId": "A"
                }
            ],
            "title": "Request Duration Heatmap",
            "type": "heatmap"
        },
        {
            "id": 9,
            "type": "stat",
            "title": "Concurrency Retry Rate (5m)",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 25
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "decimals": 2,
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "value"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(increase(application_request_concurrency_retry_total[5m])) / clamp_min(sum(increase(application_request_started_total[5m])),1)"
                }
            ]
        },
