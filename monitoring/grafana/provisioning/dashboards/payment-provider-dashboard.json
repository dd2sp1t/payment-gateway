        {
            "id": 17,
            "type": "stat",
            "title": "Failed Rate (5m)",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 1
                            },
                            {
                                "color": "red",
                                "value": 5
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "value"
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "(sum(increase({__name__=\"paymentgateway.provider.dispatch.attempt_total\", event=\"failed\"}[5m])) / clamp_min(sum(increase({__name__=\"paymentgateway.provider.dispatch.attempt_total\", event=\"started\"}[5m])),1)) * 100",
                    "legendFormat": "Failed Rate",
                    "refId": "A"
                }
            ]
        },
