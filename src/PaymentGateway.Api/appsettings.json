{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "LuckyPennySoftware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:0"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "PaymentGateway",
      "ContainerName": "null"
    }
  },
  "PROVIDER_URL": "",
  "PaymentProviderClientOptions": {
    "Timeout": "00:00:30"
  },
  "DispatchOptions": {
    "MaxRetryCount": 5,
    "BaseDelaySeconds": 1,
    "MinJitterMilliseconds": 250,
    "MaxJitterMilliseconds": 1000
  },
  "DispatchOperationsBackgroundServiceOptions": {
    "Interval": "00:00:05",
    "BatchSize": 100,
    "MaxParallelDispatches": 10
  },
  "CallbackOptions": {
    "WaitTimeout": "00:01:00"
  }
}