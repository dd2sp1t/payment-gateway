{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DispatchOperationsBackgroundServiceOptions": {
    "Interval": "00:00:05",
    "BatchSize": 100,
    "MaxParallelDispatches": 10
  },
  "DispatchOptions": {
    "RetryCount": 5,
    "BaseDelaySeconds": 1,
    "MinJitterMilliseconds": 250,
    "MaxJitterMilliseconds": 1000
  },
  "PaymentProviderClientOptions": {
    "Timeout": "00:00:30"
  }
}